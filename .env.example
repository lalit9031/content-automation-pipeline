# Runtime: mock is safe and requires no paid APIs.
PIPELINE_MODE=mock
CONTENT_OUTPUT_DIR=output

# Prompt Bot: switch to openai after installing the live dependencies.
PROMPT_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional alternative prompt provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Image Bot: switch to imagen after authenticating to Google Cloud.
IMAGE_PROVIDER=imagen
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
IMAGEN_MODEL=imagen-4.0-generate-001

# Planned cloud output storage.
GCS_BUCKET=

# Publishing stays disabled until accounts and approvals are ready.
PUBLISH_LINKEDIN=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=

# Canva Connect API — brand-template autofill & export.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://127.0.0.1:8080/callback
CANVA_REFRESH_TOKEN=
# Set to a Canva brand template ID (e.g. AEN3TrQftXo) to enable video via Canva.
# Leave blank to fall back to local FFmpeg rendering (if/when implemented).
CANVA_BRAND_TEMPLATE_ID=
