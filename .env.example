# Runtime: mock is safe and requires no paid APIs.
PIPELINE_MODE=mock
CONTENT_OUTPUT_DIR=output

# Prompt Bot: switch to openai after installing the live dependencies.
PROMPT_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=
OPENAI_API_KEY_4=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional alternative prompt provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Image Bot: use gemini, openai, imagen, or mock.
IMAGE_PROVIDER=imagen
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
IMAGEN_MODEL=imagen-4.0-generate-001
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_IMAGE_DAILY_BUDGET=0
GEMINI_IMAGE_MIN_INTERVAL_SECONDS=30
IMAGE_REQUEST_DELAY_SECONDS=15
GEMINI_IMAGE_MAX_ATTEMPTS=8
GEMINI_IMAGE_RETRY_BACKOFF_SECONDS=120
IMAGE_FALLBACK_PROVIDER=mock
VOICE_PROVIDER=edge
INDIAN_TTS_VOICE=en-IN-PrabhatNeural
REFERENCE_AUDIO_DIR=
IMAGE_MAX_DIMENSION=2048
IMAGE_MAX_BYTES=5242880

# Google Gemini / Veo for optional video generation.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_VIDEO_MODEL=veo-3.0-fast-generate-001
GEMINI_VIDEO_POLL_SECONDS=10
GEMINI_VIDEO_PRICE_PER_SECOND_USD=0.15
GEMINI_VIDEO_DAILY_CLIP_BUDGET=3
GEMINI_VIDEO_MONTHLY_BUDGET_USD=25.0

# Planned cloud output storage.
GCS_BUCKET=

# Publishing stays disabled until accounts and approvals are ready.
PUBLISH_LINKEDIN=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=

# Canva Connect API — brand-template autofill & export.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://127.0.0.1:8080/callback
CANVA_REFRESH_TOKEN=
# Set to a Canva brand template ID (e.g. AEN3TrQftXo) to enable video via Canva.
# Leave blank to fall back to local FFmpeg rendering (if/when implemented).
CANVA_BRAND_TEMPLATE_ID=
